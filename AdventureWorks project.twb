            <column caption='Financial month' datatype='integer' name='[Calculation_0548158991421446]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF MONTH([OrderDate]) &gt;= 7 THEN&#13;&#10;    MONTH([OrderDate]) - 6&#13;&#10;ELSE&#13;&#10;    MONTH([OrderDate]) + 6&#13;&#10;END' />
