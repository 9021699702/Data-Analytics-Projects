      <aliases enabled='yes' />
      <column caption='Arabic Description' datatype='string' name='[ArabicDescription]' role='dimension' type='nominal' />
      <column caption='Birth Date' datatype='date' name='[BirthDate]' role='dimension' type='ordinal' />
      <column caption='Customerfullname' datatype='string' name='[Calculation_0548158979383296]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[FirstName] + &quot; &quot; + [LastName]' />
      </column>
      <column caption='Year' datatype='integer' name='[Calculation_0548158984208385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='YEAR([OrderDate])' />
      </column>
      <column caption='Month' datatype='string' name='[Calculation_0548158985445378]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;,[OrderDate])' />
      </column>
      <column caption='Quarter' datatype='integer' name='[Calculation_0548158987923459]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='DATEPART(&apos;quarter&apos;,[OrderDate])' />
      </column>
      <column caption='Weekday' datatype='string' name='[Calculation_0548158988431364]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;,[OrderDate])' />
      </column>
      <column caption='Year-Month' datatype='datetime' name='[Calculation_0548158990393349]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[OrderDate])' />
      </column>
      <column caption='Financial month' datatype='integer' name='[Calculation_0548158991421446]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF MONTH([OrderDate]) &gt;= 7 THEN&#13;&#10;    MONTH([OrderDate]) - 6&#13;&#10;ELSE&#13;&#10;    MONTH([OrderDate]) + 6&#13;&#10;END' />
      </column>
      <column caption='Financial quarter' datatype='string' name='[Calculation_0548158992334855]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Q&quot; +&#13;&#10;STR(&#13;&#10;    IF MONTH([OrderDate]) &gt;= 7 THEN&#13;&#10;        CEILING((MONTH([OrderDate]) - 6) / 3.0)&#13;&#10;    ELSE&#13;&#10;        CEILING((MONTH([OrderDate]) + 6) / 3.0)&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Sales amount' datatype='real' name='[Calculation_0548158994632712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[UnitPrice] * [OrderQuantity] * (1 - [UnitPriceDiscountPct])' />
      </column>
